generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  password          String
  phone             String
  address           String?
  role              Role      @default(DONOR)
  isVerified        Boolean   @default(false)
  verificationToken String?
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // For CareHome specific fields
  registrationNo String?
  category       CareHomeCategory?

  donations        Donation[]
  needs            Need[]
  inventory        Inventory[]
  offeredMealSlots MealDonationSlot[] @relation("CareHomeMeals")
  bookedMeals      MealDonationSlot[] @relation("DonorBookedMeals")
  notifications    Notification[]

  donorChats    Chat[]    @relation("DonorChats")
  careHomeChats Chat[]    @relation("CareHomeChats")
  messages      Message[]

  @@map("users")
}

enum Role {
  DONOR
  CAREHOME
}

enum CareHomeCategory {
  CHILDREN
  ADULTS
  SENIORS
  DISABLED
  GENERAL
}

model Inventory {
  id              Int        @id @default(autoincrement())
  itemName        String
  category        String
  stockLevel      Int
  reorderLevel    Int
  unit            String     @default("units")
  itemDescription String?
  userId          Int
  user            User       @relation(fields: [userId], references: [id])
  donations       Donation[] @relation("InventoryDonations")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("inventory")
}

model Donation {
  id          Int        @id @default(autoincrement())
  quantity    Int
  date        DateTime   @default(now())
  status      String     @default("pending")
  notes       String?
  donorId     Int
  donor       User       @relation(fields: [donorId], references: [id])
  needId      Int
  need        Need       @relation(fields: [needId], references: [id], name: "NeedDonations")
  inventory   Inventory? @relation(fields: [inventoryId], references: [id], name: "InventoryDonations")
  inventoryId Int?

  @@map("donations")
}

model Need {
  id               Int        @id @default(autoincrement())
  itemName         String
  requiredQuantity Int
  currentQuantity  Int
  category         String
  urgencyLevel     String     @db.VarChar(10)
  unit             String     @default("units")
  userId           Int
  user             User       @relation(fields: [userId], references: [id])
  donations        Donation[] @relation("NeedDonations")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  isAutoGenerated  Boolean    @default(false)

  @@map("needs")
}

model MealDonationSlot {
  id              Int        @id @default(autoincrement())
  date            DateTime
  mealType        MealType
  status          SlotStatus @default(Available)
  careHomeId      Int
  careHome        User       @relation("CareHomeMeals", fields: [careHomeId], references: [id])
  donorId         Int?
  donor           User?      @relation("DonorBookedMeals", fields: [donorId], references: [id])
  reservationTime DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([date, mealType, careHomeId])
}

model Chat {
  id         Int      @id @default(autoincrement())
  donorId    Int
  careHomeId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  donor    User      @relation("DonorChats", fields: [donorId], references: [id])
  careHome User      @relation("CareHomeChats", fields: [careHomeId], references: [id])
  messages Message[]

  @@unique([donorId, careHomeId])
  @@map("chats")
}

model Message {
  id          Int      @id @default(autoincrement())
  content     String
  senderId    Int
  chatId      Int
  read        Boolean  @default(false)
  messageType String   @default("TEXT")
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String
  isRead    Boolean  @default(false)
  relatedId Int?
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

enum MealType {
  Breakfast
  Lunch
  Dinner
}

enum SlotStatus {
  Available
  Booked
  Completed
  Cancelled
  Reserved
}

enum NotificationType {
  LOW_STOCK
  NEW_DONATION
  DONATION_STATUS
  MEAL_BOOKING
  SYSTEM
}